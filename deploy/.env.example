NETRELAY_PUBLIC_BASE_URL=https://netrelay.example
NETRELAY_GITHUB_REPOSITORY=owner/repository
NETRELAY_GITHUB_SYNC_ENABLED=false
NETRELAY_GITHUB_TOKEN=
NETRELAY_GITHUB_PAGES_BRANCH=gh-pages
NETRELAY_GITHUB_RELEASE_TAG_PREFIX=v
NETRELAY_GITHUB_ASSET_NAME=win-x64.zip
NETRELAY_MYSQL_DATABASE=netrelay
NETRELAY_MYSQL_USER=netrelay
NETRELAY_MYSQL_PASSWORD=replace-with-a-long-random-password
NETRELAY_MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
NETRELAY_ADMIN_USERNAME=admin
NETRELAY_ADMIN_PASSWORD=replace-with-a-long-admin-password
NETRELAY_ADMIN_TOTP_SECRET=replace-with-a-base32-secret
