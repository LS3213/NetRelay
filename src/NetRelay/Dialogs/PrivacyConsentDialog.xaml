<Window x:Class="NetRelay.Dialogs.PrivacyConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户隐私与服务同意" Width="480" Height="380"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True">
    <Border Margin="20" Padding="25" CornerRadius="26" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.25" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="15" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE727;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="用户隐私与服务同意" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="首次运行需要勾选同意并激活设备" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,18,0,18" TextWrapping="Wrap" LineHeight="18"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center">
                欢迎使用 NetRelay。在您开启自动化控制功能前，我们需要连接到后端平台对您的设备进行匿名激活。
                <LineBreak/><LineBreak/>
                此过程仅收集基于主板、CPU、磁盘和物理网卡等硬件信息脱敏计算后的 SHA-256 应用哈希，用于设备激活标识与防滥用安全审计。
                <LineBreak/><LineBreak/>
                我们郑重承诺：
                <LineBreak/>
                1. 绝不收集或上传任何用户名、个人文件、历史或附近 Wi-Fi 等隐私信息；
                <LineBreak/>
                2. 绝不收集与上传原始硬件序列号。
                <LineBreak/><LineBreak/>
                详细条款请点击下方链接阅读。
            </TextBlock>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <CheckBox x:Name="AgreeCheckBox" VerticalAlignment="Center" Checked="AgreeCheckBox_Changed" Unchecked="AgreeCheckBox_Changed"/>
                <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    我已阅读并同意
                    <Hyperlink Click="Terms_Click" Foreground="#536EF2">用户协议</Hyperlink>
                    和
                    <Hyperlink Click="Privacy_Click" Foreground="#536EF2">隐私政策</Hyperlink>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Click="RejectButton_Click" Content="不同意并退出"/>
                <Button Grid.Column="2" x:Name="AcceptButton" Style="{StaticResource PrimaryButtonStyle}" Click="AcceptButton_Click" Content="同意并激活" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
