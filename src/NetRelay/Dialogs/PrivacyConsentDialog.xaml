<Window x:Class="NetRelay.Dialogs.PrivacyConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户隐私与服务同意" Width="520" Height="470"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True">

    <Border Margin="12" Padding="24" CornerRadius="22" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.20" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="42" Height="42" CornerRadius="14" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE727;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="用户隐私与服务同意" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="首次运行需勾选同意后激活设备" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="16" Background="#68FFFFFF" BorderBrush="#80FFFFFF"
                    BorderThickness="1" Padding="16" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5">
                    <Run Text="欢迎使用 NetRelay。在开启自动化控制功能前，我们需要连接后端平台对设备进行匿名激活。"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="此过程仅收集基于主板、CPU、磁盘和物理网卡等硬件信息脱敏计算后的 SHA-256 应用哈希，用于设备激活标识与防滥用安全审计。"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="我们郑重承诺："/>
                    <LineBreak/>
                    <Run Text="1. 绝不收集或上传任何用户名、个人文件、历史或附近 Wi-Fi 等隐私信息；"/>
                    <LineBreak/>
                    <Run Text="2. 绝不收集与上传原始硬件序列号。"/>
                </TextBlock>
            </Border>

            <Border Grid.Row="2" CornerRadius="14" Background="#52FFFFFF" BorderBrush="#70FFFFFF"
                    BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AgreeCheckBox" VerticalAlignment="Center" Checked="AgreeCheckBox_Changed" Unchecked="AgreeCheckBox_Changed"/>
                    <TextBlock Margin="9,0,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <Run Text="我已阅读并同意 "/>
                        <Hyperlink Click="Terms_Click" Foreground="#536EF2">用户协议</Hyperlink>
                        <Run Text=" 和 "/>
                        <Hyperlink Click="Privacy_Click" Foreground="#536EF2">隐私政策</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Click="RejectButton_Click" Content="不同意并退出" Height="38"/>
                <Button Grid.Column="2" x:Name="AcceptButton" Style="{StaticResource PrimaryButtonStyle}" Click="AcceptButton_Click" Content="请先勾选同意" Height="38" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
