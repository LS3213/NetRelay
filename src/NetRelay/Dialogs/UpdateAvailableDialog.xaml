<Window x:Class="NetRelay.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Border Margin="14" Padding="26" CornerRadius="24" Background="#F4F8FD" BorderBrush="White" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.22" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="14" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="发现新版本" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Border x:Name="MandatoryBadge" Background="#18E85C63" BorderBrush="#45E85C63" BorderThickness="1" CornerRadius="9" Padding="9,4" Margin="14,6,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="强制更新" Foreground="#D83E4B" FontSize="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,20,0,8">
                <TextBlock x:Name="ReleaseDateText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBlock x:Name="SourceText" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBlock x:Name="PackageText" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <Border x:Name="PreflightPanel" Margin="0,10,0,0" Padding="12,9" CornerRadius="12" Background="#63FFFFFF" BorderBrush="#B5FFFFFF" BorderThickness="1" Visibility="Collapsed">
                    <TextBlock x:Name="PreflightText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" LineHeight="18"/>
                </Border>
            </StackPanel>
            <Border Grid.Row="2" CornerRadius="14" Background="#75FFFFFF" BorderBrush="#C8FFFFFF" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LaterButton" Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Content="稍后处理" Height="40" Click="LaterButton_Click"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="立即更新" Height="40" Click="UpdateButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
