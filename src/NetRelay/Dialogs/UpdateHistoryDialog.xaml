<Window x:Class="NetRelay.Dialogs.UpdateHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="540" WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" CornerRadius="16" Padding="12" Background="#55FFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Width="4" CornerRadius="2" Background="Transparent"/>
                                <ContentPresenter Grid.Column="1" Margin="11,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#8FFFFFFF"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#D8FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#F2FFFFFF"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#70536EF2"/>
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Padding="26" CornerRadius="28" Background="#EEF5FC" BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.18" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="15" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="更新历史" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="仅展示当前通道仍在发布的版本" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="20" Background="#60FFFFFF" BorderBrush="#C8FFFFFF" BorderThickness="1" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="HistoryList"
                                 ItemsSource="{Binding}"
                                 SelectionChanged="HistoryList_SelectionChanged"
                                 ItemContainerStyle="{StaticResource HistoryItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" CornerRadius="20" Background="#85FFFFFF" BorderBrush="#D8FFFFFF" BorderThickness="1" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DetailVersionText" Text="选择版本" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="DetailDateText" Text="选择一个版本查看详细更新日志" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="PolicyBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="10,5" Background="#14536EF2" BorderBrush="#30536EF2" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="PolicyText" Text="可选更新" Foreground="#536EF2" FontWeight="Bold" FontSize="10"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="#18000000" Margin="0,18,0,18"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailsText"
                                       Text="选择一个版本查看详细更新日志。"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="2" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="关闭" Width="104" Height="38" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
