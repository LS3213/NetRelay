<Window x:Class="NetRelay.Dialogs.BlockWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全受限模式警告" Width="480" Height="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Margin="15" Padding="25" CornerRadius="24" Background="#FFFDF7F7"
            BorderBrush="#30E81123" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="6" Opacity="0.25" Color="#E81123"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="IconBorder" Width="46" Height="46" CornerRadius="16" Background="#1AE81123" BorderBrush="#30E81123" BorderThickness="1">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="#E81123" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="此设备或版本已被封锁" FontWeight="Bold" FontSize="16" Foreground="#D11D29"/>
                    <TextBlock x:Name="ExpiryTextBlock" Text="解封时间: --" Foreground="#8A3C42" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Reason Viewer -->
            <FlowDocumentScrollViewer x:Name="DocViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Margin="0,10"/>

            <!-- Expiry Warning Alert -->
            <Border Grid.Row="2" Background="#0AE81123" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderThickness="0.5" BorderBrush="#20E81123">
                <TextBlock Text="受限模式已启用：网卡启用/禁用与后台自动调度均被停用。您仍可在此界面检查更新并提交申诉。" 
                           Foreground="#A81824" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AppealButton" Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" Content="前往外部申诉" Click="AppealButton_Click" HorizontalAlignment="Left" Width="130" Visibility="Collapsed"/>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="进入受限模式" Click="CloseButton_Click" Width="120" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
