<Window x:Class="NetRelay.Dialogs.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="400" Height="240"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Margin="15" Padding="25" CornerRadius="20" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.20" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (Icon & Title) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Border x:Name="IconBorder" Width="38" Height="38" CornerRadius="12" BorderThickness="1" Background="#1A536EF2" BorderBrush="#30536EF2">
                    <TextBlock x:Name="IconTextBlock" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#536EF2" Text="&#xE946;"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleTextBlock" Margin="12,0,0,0" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="提示"/>
            </StackPanel>

            <!-- Message Text -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" LineHeight="16" Text="消息内容"/>
            </ScrollViewer>

            <!-- Buttons Grid -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource SoftButtonStyle}" Content="取消" Width="80" Height="28" Margin="0,0,8,0" Click="CancelButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="NoButton" Style="{StaticResource SoftButtonStyle}" Content="否" Width="80" Height="28" Margin="0,0,8,0" Click="NoButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="YesButton" Style="{StaticResource PrimaryButtonStyle}" Content="是" Width="80" Height="28" Margin="0,0,8,0" Click="YesButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButtonStyle}" Content="确定" Width="80" Height="28" Click="OkButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
