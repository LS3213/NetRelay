<Window x:Class="NetRelay.Dialogs.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问题与建议反馈" Width="480" Height="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#80FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#536EF2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#536EF2"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Margin="15" Padding="25" CornerRadius="24" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.20" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Navigation Tabs -->
                <RowDefinition Height="*"/>    <!-- Content Panel -->
                <RowDefinition Height="Auto"/> <!-- Progress -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="40" Height="40" CornerRadius="14" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="问题与建议反馈" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="帮助我们持续改进 NetRelay 体验" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Navigation Tabs -->
            <Border Grid.Row="1" Background="#12000000" CornerRadius="10" Padding="3" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabFeedbackBtn" Grid.Column="0" Content="我要反馈" Height="28" Click="TabFeedbackBtn_Click" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="TabHistoryBtn" Grid.Column="1" Content="反馈历史与进度" Height="28" Click="TabHistoryBtn_Click" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Panel: Feedback Submission Form -->
            <ScrollViewer x:Name="SubmissionFormPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="反馈类型 *"/>
                    <ComboBox x:Name="TypeComboBox" Margin="0,0,0,12" SelectedIndex="0">
                        <ComboBoxItem Content="程序缺陷 / Bug"/>
                        <ComboBoxItem Content="功能建议"/>
                        <ComboBoxItem Content="其他"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="反馈标题 *"/>
                    <TextBox x:Name="TitleTextBox" Margin="0,0,0,12" MaxLength="100"/>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="问题描述 / 建议详情 *"/>
                    <TextBox x:Name="ContentTextBox" Margin="0,0,0,12" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="8,6" MaxLength="1000"/>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="联系方式 (选填，建议留下邮箱以方便我们向您回复)"/>
                    <TextBox x:Name="ContactTextBox" Margin="0,0,0,15" MaxLength="100"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="IncludeLogsCheckBox" Content="附带系统诊断日志" IsChecked="True"
                                  Checked="IncludeLogsCheckBox_Changed" Unchecked="IncludeLogsCheckBox_Changed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LogSizeTextBlock" Text="(计算中...)" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Content Panel: Feedback History & Progress -->
            <Grid x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- History List -->
                <ListBox x:Name="HistoryListBox" Grid.Row="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" SelectionChanged="HistoryListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" CornerRadius="10" Background="#80FFFFFF" BorderBrush="#15000000" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="#333333" TextTrimming="CharacterEllipsis"/>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" Grid.Row="0" Padding="6,2" CornerRadius="4" Background="{Binding StatusBg}" BorderThickness="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                    </Border>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CreatedAtLabel}" FontSize="10" Foreground="#888888" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="#15000000" Margin="0,8,0,8"/>

                <!-- Feedback Details Viewer -->
                <Grid Grid.Row="2" x:Name="DetailsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="反馈正文与回复" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" x:Name="DetailsContentTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="#40FFFFFF" BorderBrush="#15000000" BorderThickness="1" FontSize="11" Foreground="#444444" Padding="6"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="NoSelectionTextBlock" Text="选择上方反馈以查看详情" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Progress Area -->
            <StackPanel Grid.Row="3" x:Name="ProgressPanel" Margin="0,0,0,15" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ProgressStatusTextBlock" Text="正在上传诊断日志与提交反馈..." FontSize="11" Foreground="#536EF2"/>
                    <TextBlock x:Name="ProgressPercentTextBlock" Text="0%" FontSize="11" Foreground="#536EF2" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="UploadProgressBar" Height="6" Margin="0,6,0,8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#536EF2" Background="#20536EF2"/>
                <Button Style="{StaticResource SoftButtonStyle}" Content="取消上传" HorizontalAlignment="Right" Width="100" Click="CancelUploadButton_Click"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="4" x:Name="ButtonPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Content="关闭" Click="CloseButton_Click"/>
                <Button Grid.Column="2" x:Name="SubmitButton" Style="{StaticResource PrimaryButtonStyle}" Content="提交反馈" Click="SubmitButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
