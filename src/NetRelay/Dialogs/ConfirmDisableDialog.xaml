<Window x:Class="NetRelay.Dialogs.ConfirmDisableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认禁用网卡" Width="430" Height="350"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Margin="20" Padding="25" CornerRadius="26" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.25" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="15" Background="#1AE85C63" BorderBrush="#30E85C63" BorderThickness="1">
                    <Path Width="19" Height="19" Stretch="Uniform" Stroke="#E85C63" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 10,2 L 18,17 L 2,17 Z M 10,7 L 10,12 M 10,15 L 10,15.1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="确认禁用网卡？" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="此操作可能立即中断当前网络" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,20,0,0" Padding="14" CornerRadius="16" Background="#A8FFFFFF">
                <StackPanel>
                    <TextBlock x:Name="AdapterNameText" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="AdapterDetailsText" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="18"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                       Text="如果选错接口，手机热点或其他备用网络也可能无法接管流量。禁用后可从 NetRelay 重新启用。"/>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Click="CancelButton_Click" Content="取消"/>
                <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Click="ConfirmButton_Click"
                        Content="确认禁用"/>
            </Grid>
        </Grid>
    </Border>
</Window>
