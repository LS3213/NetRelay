<Window x:Class="NetRelay.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序设置" Width="660" Height="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">


    <Border Margin="20" Padding="25" CornerRadius="26" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.25" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="15" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="程序设置" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="管理主程序的基础运行选项" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#66FFFFFF" BorderBrush="#C8FFFFFF" BorderThickness="1" CornerRadius="20" Padding="10">
                    <StackPanel>
                        <Button x:Name="GeneralSectionButton" Style="{StaticResource SoftButtonStyle}" Click="GeneralSectionButton_Click" Content="基础设置" Margin="0,0,0,10" Padding="16,10"/>
                        <Button x:Name="DiagnosticsSectionButton" Style="{StaticResource SoftButtonStyle}" Click="DiagnosticsSectionButton_Click" Content="诊断工具" Margin="0,0,0,10" Padding="16,10"/>
                        <Button x:Name="DefaultsSectionButton" Style="{StaticResource SoftButtonStyle}" Click="DefaultsSectionButton_Click" Content="规则默认" Padding="16,10"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#66FFFFFF" BorderBrush="#C8FFFFFF" BorderThickness="1" CornerRadius="20" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="GeneralSection">
                                <TextBlock Text="基础设置" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="管理窗口关闭方式和随系统启动行为。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>

                                <TextBlock Text="关闭窗口行为" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,22,0,8"/>
                                <RadioButton x:Name="AskOnCloseRadio" GroupName="CloseActionGroup" Content="每次关闭时都进行询问"
                                              Margin="4,2,0,6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="HideToTrayRadio" GroupName="CloseActionGroup" Content="直接隐藏到任务栏托盘（推荐）"
                                              Margin="4,0,0,6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <RadioButton x:Name="ExitProgramRadio" GroupName="CloseActionGroup" Content="直接退出主程序"
                                              Margin="4,0,0,8" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="您也可以在托盘图标右键菜单中随时选择退出程序。"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="4,0,0,0"/>

                                <TextBlock Text="系统选项" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,22,0,8"/>
                                <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动 NetRelay"
                                          Margin="4,0,0,8" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="StartupCheckUpdatesCheckBox" Content="启动时静默检查更新"
                                          Margin="4,0,0,0" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="DiagnosticsSection" Visibility="Collapsed">
                                <TextBlock Text="诊断工具" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="导出诊断包、查看日志并清理本地更新缓存。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>

                                <Border Background="#73FFFFFF" BorderBrush="#C8FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="AutomationStatusText" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LastCheckStatusText" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LastDownloadStatusText" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Style="{StaticResource SoftButtonStyle}" Click="ExportDiagnosticsButton_Click" Content="导出诊断包" Margin="0,0,10,10" Padding="16,9"/>
                                    <Button Style="{StaticResource SoftButtonStyle}" Click="OpenLogsButton_Click" Content="打开日志目录" Margin="0,0,10,10" Padding="16,9"/>
                                    <Button Style="{StaticResource SoftButtonStyle}" Click="OpenUpdateCacheButton_Click" Content="打开更新缓存" Margin="0,0,10,10" Padding="16,9"/>
                                    <Button Style="{StaticResource DangerButtonStyle}" Click="ClearUpdateCacheButton_Click" Content="清理更新缓存" Margin="0,0,0,10" Padding="16,9"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel x:Name="DefaultsSection" Visibility="Collapsed">
                                <TextBlock Text="规则默认" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="这些值只影响新建规则，不会修改已经存在的规则。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>

                                <Grid Margin="0,22,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="新建规则默认防抖时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="DebounceValueText" Grid.Column="1" Text="10 秒" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                                    <Slider x:Name="DebounceSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" ValueChanged="DebounceSlider_ValueChanged"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="新建规则默认冷却时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="CooldownValueText" Grid.Column="1" Text="5 分钟" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                                    <Slider x:Name="CooldownSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" ValueChanged="CooldownSlider_ValueChanged"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="日志保留天数上限" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="KeepDaysValueText" Grid.Column="1" Text="30 天" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                                    <Slider x:Name="KeepDaysSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="90" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" ValueChanged="KeepDaysSlider_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Click="CancelButton_Click" Content="取消"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" Content="保存设置"/>
            </Grid>
        </Grid>
    </Border>
</Window>
