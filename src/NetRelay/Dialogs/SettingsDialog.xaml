<Window x:Class="NetRelay.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序设置" Width="430" Height="590"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">


    <Border Margin="20" Padding="25" CornerRadius="26" Background="#F4F8FD"
            BorderBrush="#FFFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.25" Color="#263753"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="15" Background="#1A536EF2" BorderBrush="#30536EF2" BorderThickness="1">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#536EF2" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="程序设置" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="管理主程序的基础运行选项" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                <TextBlock Text="关闭窗口行为" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                <RadioButton x:Name="AskOnCloseRadio" GroupName="CloseActionGroup" Content="每次关闭时都进行询问"
                              Margin="4,2,0,6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>

                <RadioButton x:Name="HideToTrayRadio" GroupName="CloseActionGroup" Content="直接隐藏到任务栏托盘（推荐）"
                              Margin="4,0,0,6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>

                <RadioButton x:Name="ExitProgramRadio" GroupName="CloseActionGroup" Content="直接退出主程序"
                              Margin="4,0,0,8" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="* 您也可以在托盘图标右键菜单中随时选择退出程序。"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="4,0,0,12"/>

                <TextBlock Text="系统选项" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动 NetRelay"
                          Margin="4,0,0,4" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalContentAlignment="Center"/>

                <TextBlock Text="新建规则默认值与日志" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="防抖和冷却仅作为新建规则默认值，不会修改已有规则。"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="4,0,0,8"/>

                <Grid Margin="4,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="新建规则默认防抖时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DebounceValueText" Grid.Column="1" Text="10 秒" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                    <Slider x:Name="DebounceSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0" ValueChanged="DebounceSlider_ValueChanged"/>
                </Grid>

                <Grid Margin="4,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="新建规则默认冷却时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="CooldownValueText" Grid.Column="1" Text="5 分钟" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                    <Slider x:Name="CooldownSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0" ValueChanged="CooldownSlider_ValueChanged"/>
                </Grid>

                <Grid Margin="4,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="日志保留天数上限" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="KeepDaysValueText" Grid.Column="1" Text="30 天" FontSize="11" FontWeight="SemiBold" Foreground="#536EF2"/>
                    <Slider x:Name="KeepDaysSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="1" Maximum="90" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0" ValueChanged="KeepDaysSlider_ValueChanged"/>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SoftButtonStyle}" Click="CancelButton_Click" Content="取消"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" Content="保存设置"/>
            </Grid>
        </Grid>
    </Border>
</Window>
